# Copy to .env.local for development. Never commit real secrets.
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-anon-key
APP_BASE_URL=http://localhost:3000
# Optional for server-side JWT verification outside the Supabase client.
SUPABASE_JWT_SECRET=
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
AUTH_INTERNAL_EMAIL_DOMAIN=accounts.example.org
PUBLIC_INTERACTION_HMAC_KEY=replace-with-a-random-secret-of-at-least-32-characters
# Optional notification worker and provider webhooks. Keep every value server-side.
NOTIFICATION_WORKER_SECRET=
CRON_SECRET=
NOTIFICATION_EMAIL_WEBHOOK_URL=
NOTIFICATION_EMAIL_WEBHOOK_TOKEN=
NOTIFICATION_SMS_WEBHOOK_URL=
NOTIFICATION_SMS_WEBHOOK_TOKEN=
NOTIFICATION_PUSH_WEBHOOK_URL=
NOTIFICATION_PUSH_WEBHOOK_TOKEN=
# Real providers. Push is free; email/SMS require provider accounts.
RESEND_API_KEY=
EMAIL_FROM=e-Mawahib <notifications@example.org>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org
OTP_HMAC_SECRET=
